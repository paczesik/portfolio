---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Portfolio placeholder' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Your Name</a>
        <nav aria-label="Main">
          <ul>
            <li><a href="#work">Work</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} Your Name</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf9; --fg: #1c1917; --muted: #6b6b66;
    --line: #e4e2dd; --card: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161513; --fg: #f2f0eb; --muted: #a09d95; --line: #2d2b27; --card: #1e1d1a; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 1.0625rem/1.6 system-ui, sans-serif; }
  a { color: inherit; }
  .wrap { max-width: 64rem; margin-inline: auto; padding-inline: 1.25rem; }

  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; padding: .5rem .75rem; background: var(--fg); color: var(--bg); z-index: 10; }

  .site-header { border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding-block: 1rem; }
  .brand { font-weight: 700; text-decoration: none; }
  nav ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a:focus-visible { color: var(--fg); text-decoration: underline; }

  main section { padding-block: 3.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.1; margin: 0 0 1rem; }
  h2 { margin: 0 0 1.5rem; }
  .lede { max-width: 40rem; color: var(--muted); }

  .grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: .75rem; overflow: hidden; }
  .thumb { aspect-ratio: 4 / 3; background: repeating-linear-gradient(45deg, var(--line) 0 10px, transparent 10px 20px); }
  .card .body { padding: 1rem 1.25rem 1.25rem; }
  .card h3 { margin: 0; }
  .card .meta, .card p { margin: .25rem 0 0; color: var(--muted); }

  .site-footer { border-top: 1px solid var(--line); padding-block: 1.5rem; color: var(--muted); }
</style>
