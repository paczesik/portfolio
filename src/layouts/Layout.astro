---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Portfolio placeholder' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1026" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={import.meta.env.BASE_URL}>Your Name</a>
        <nav aria-label="Main">
          <ul>
            <li><a href="#work">Work</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} Your Name</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b1026;
    --card: #131a3a;
    --fg: #e8ebf7;
    --muted: #9aa4c7;
    --line: #263059;
    --accent: #ff8a3d;
    --accent-soft: rgba(255, 138, 61, 0.22);
    --font-body: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --font-head: "Fraunces", Georgia, "Times New Roman", serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--fg);
    font: 400 0.95rem/1.75 var(--font-body);
    background-color: var(--bg);
    background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, rgba(255,255,255,.9), transparent),
      radial-gradient(1px 1px at 28% 62%, rgba(255,255,255,.7), transparent),
      radial-gradient(1.5px 1.5px at 46% 9%, rgba(255,255,255,.8), transparent),
      radial-gradient(1px 1px at 63% 41%, rgba(255,255,255,.6), transparent),
      radial-gradient(1.5px 1.5px at 81% 22%, rgba(255,255,255,.9), transparent),
      radial-gradient(1px 1px at 90% 74%, rgba(255,255,255,.7), transparent),
      radial-gradient(1px 1px at 7% 85%, rgba(255,255,255,.6), transparent),
      linear-gradient(180deg, #0b1026 0%, #111845 100%);
  }

  ::selection { background: var(--accent); color: var(--bg); }
  a { color: var(--accent); text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .wrap { max-width: 64rem; margin-inline: auto; padding-inline: 1.25rem; }

  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; padding: .5rem .75rem; background: var(--accent); color: var(--bg); z-index: 10; }

  .site-header { border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding-block: 1rem; }
  .brand { font-family: var(--font-head); font-size: 1.25rem; font-weight: 600; text-decoration: none; color: var(--accent); }
  nav ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a:focus-visible { color: var(--accent); text-decoration: underline; }

  main section { padding-block: 3.5rem; }
  h1, h2, h3 { font-family: var(--font-head); font-weight: 600; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.75rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 1rem; }
  h2 { font-size: 1.75rem; margin: 0 0 1.75rem; }
  h2::after { content: ""; display: block; width: 3rem; height: 3px; margin-top: .5rem; background: var(--accent); border-radius: 2px; }
  .lede { max-width: 60ch; color: var(--muted); }

  .grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: .75rem; overflow: hidden; }
  .card:hover, .card:focus-within { border-color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .card { transition: transform .2s ease, border-color .2s ease; }
    .card:hover { transform: translateY(-3px); }
  }
  .thumb {
    aspect-ratio: 4 / 3;
    background:
      radial-gradient(circle at 30% 30%, var(--accent-soft), transparent 60%),
      repeating-linear-gradient(45deg, var(--line) 0 10px, transparent 10px 20px);
  }
  .card .body { padding: 1rem 1.25rem 1.25rem; }
  .card h3 { margin: 0; font-size: 1.25rem; }
  .card h3 a { color: var(--fg); text-decoration: none; }
  .card h3 a:hover { color: var(--accent); }
  .card .meta, .card p { margin: .25rem 0 0; color: var(--muted); }
  .card .meta { color: var(--accent); font-size: .85rem; }

  .site-footer { border-top: 1px solid var(--line); padding-block: 1.5rem; color: var(--muted); font-size: .85rem; }
</style>
